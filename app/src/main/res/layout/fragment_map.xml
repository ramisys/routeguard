<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- Map -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Top bar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_margin="12dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="26dp"
        app:cardElevation="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_search"
                android:layout_marginEnd="8dp"
                app:tint="@color/accent_teal" />

            <TextView
                android:id="@+id/tvSearchHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/search_hint"
                android:textColor="@color/text_hint"
                android:textSize="15sp" />

            <!-- Notification icon -->
            <FrameLayout
                android:id="@+id/ivNotification"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@android:drawable/ic_popup_reminder"
                    android:padding="8dp"
                    app:tint="@color/text_primary" />

                <TextView
                    android:id="@+id/tvNotifBadge"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:text="3"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:background="@drawable/bg_badge_red"
                    android:layout_gravity="top|end" />
            </FrameLayout>

            <!-- Profile icon -->
            <ImageView
                android:id="@+id/ivProfile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_person"
                android:padding="8dp"
                app:tint="@color/text_primary" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- GPS Button -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMyLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="140dp"
        android:src="@android:drawable/ic_menu_mylocation"
        app:backgroundTint="@color/bg_card"
        app:tint="@color/accent_teal"
        app:fabSize="normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom nav (Dummy removed as it's handled by activity_main) -->
</androidx.constraintlayout.widget.ConstraintLayout>