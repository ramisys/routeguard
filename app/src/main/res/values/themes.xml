<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.RouteGuard" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.RouteGuard" parent="Base.Theme.RouteGuard">
        <item name="actionOverflowMenuStyle">@style/CustomPopupMenu</item>
    </style>

    <style name="CustomPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:itemBackground">@color/bg_card</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>

    <style name="App.CustomIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#2600C896</item>
        <item name="android:width">48dp</item>
        <item name="android:height">48dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Circle</item>
    </style>

    <style name="ShapeAppearance.Circle" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>